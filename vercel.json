{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/diag", "destination": "/api/ping" },
    { "source": "/health", "destination": "/api?path=/health" },
    { "source": "/api/(.*)", "destination": "/api?path=/api/$1" },
    { "source": "/embed/(.*)", "destination": "/api?path=/embed/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
