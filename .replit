modules = ["nodejs-20", "python-3.11", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 23636
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seed-idempotency"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "security-probes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-preamble"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "yhsi-metrics"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "yhsi-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "youth-mode-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "access-model-guards"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "auth-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "academy-economy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "touch-targets"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "canvas-wire-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "trade-sims"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "hud-pdf-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "community-brief-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "directory-links"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "referral-loop"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "seed-idempotency"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-seed-idempotency.ts && npx tsx scripts/verify-seed-provenance.ts"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'NODE_OPTIONS=--max-old-space-size=8192 npx tsc --noEmit -p . > /tmp/tsc-val.out 2>&1; c=$(grep -c \"error TS\" /tmp/tsc-val.out || true); echo \"tsc errors: $c (baseline 87)\"; [ \"$c\" -le 87 ]'"

[[workflows.workflow]]
name = "security-probes"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-inbound-verification.ts && npx tsx scripts/security-probes.ts && npx tsx scripts/verify-location-resolver-state.ts && npx tsx scripts/verify-gpp-endpoint.ts && npx tsx scripts/verify-heartbeat-validation.ts"

[[workflows.workflow]]
name = "ai-preamble"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-ai-preamble.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "yhsi-metrics"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test server/__tests__/yhsi-metrics.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "yhsi-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/test-yhsi-staff-guard.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "youth-mode-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-youth-mode-e2e.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "access-model-guards"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/test-access-model-guards.ts && npx tsx scripts/verify-equity-loss-frames.ts && npx tsx scripts/verify-equity-loss-nationwide.ts && npx tsx scripts/verify-equity-loss-national-api.ts"

[[workflows.workflow]]
name = "auth-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-auth-e2e.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "academy-economy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-academy-economy.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "touch-targets"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-touch-targets.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "canvas-wire-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-canvas-wire-e2e.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "trade-sims"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx client/src/lib/trade-sims/plumbing/flow-solver.test.ts && npx tsx client/src/lib/trade-sims/plumbing/backflow-rubric.test.ts && npx tsx client/src/lib/trade-sims/automotive/sag-rubric.test.ts && npx tsx client/src/lib/trade-sims/hvac/thermal-solver.test.ts && npx tsx client/src/lib/trade-sims/plumbing/pipe-size.test.ts && npx tsx client/src/lib/trade-sims/plumbing/component-defs.test.ts && npx tsx scripts/verify-lesson-content-sync.ts && npx tsx scripts/verify-lesson-diagrams.ts && npx tsx scripts/verify-trade-sims-content-sync.ts"

[[workflows.workflow]]
name = "hud-pdf-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-hud-report-pdf-e2e.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "community-brief-e2e"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-community-brief-e2e.ts && npx tsx scripts/verify-community-brief-probe-logic.ts && npx tsx scripts/verify-community-evidence-guards.ts && npx tsx scripts/verify-ai-claim-grounding.ts && npx tsx scripts/verify-claim-chain-integrity.ts && npx tsx scripts/verify-navigator-gv-grounding.ts && bash scripts/run-community-brief-playwright.sh"

[[workflows.workflow]]
name = "directory-links"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-directory-links.ts && npx tsx scripts/verify-capacity-badges.ts && npx tsx scripts/verify-sidebar-routes.ts && npx tsx scripts/verify-external-links.ts && npx tsx scripts/verify-intake-contact-validation.ts && npx tsx scripts/verify-chw-dashboard-no-555.ts && npx tsx scripts/verify-tool-reachability.ts && npx tsx scripts/verify-two-click-reachability.ts && npx tsx scripts/verify-how-to-apply.ts && npx tsx scripts/verify-apply-chat-ratelimit.ts && npx tsx scripts/verify-health-federation.ts"

[[workflows.workflow]]
name = "referral-loop"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-referral-loop-e2e.sh"

[agent]
integrations = ["javascript_openai_ai_integrations:2.0.0", "javascript_log_in_with_replit:2.0.0", "javascript_object_storage:2.0.0", "resend:1.0.0", "javascript_anthropic_ai_integrations:2.0.0", "javascript_openrouter_ai_integrations:2.0.0"]

[userenv]

[userenv.shared]
SUPPORT_PORTAL_URL = "https://student-support-portal--mrterryflood.replit.app"
CIVIC_SIGNAL_BASE_URL = "https://power2thepeople.net"
GPP_API_URL = "https://pursuitsfundingprofessionals.com"
GPP_EMBED_URL = "https://trustworthy-sheep-515.convex.site/thriveup/embed"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
