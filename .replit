modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 23636
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "seed-idempotency"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "security-probes"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-preamble"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "yhsi-metrics"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "yhsi-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "youth-mode-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "access-model-guards"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "auth-e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "academy-economy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "touch-targets"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "seed-idempotency"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-seed-idempotency.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'NODE_OPTIONS=--max-old-space-size=8192 npx tsc --noEmit -p . > /tmp/tsc-val.out 2>&1; c=$(grep -c \"error TS\" /tmp/tsc-val.out || true); echo \"tsc errors: $c (baseline 85)\"; [ \"$c\" -le 85 ]'"

[[workflows.workflow]]
name = "security-probes"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/security-probes.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "ai-preamble"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-ai-preamble.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "yhsi-metrics"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx --test server/__tests__/yhsi-metrics.test.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "yhsi-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/test-yhsi-staff-guard.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "youth-mode-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-youth-mode-e2e.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "access-model-guards"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/test-access-model-guards.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "auth-e2e"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-auth-e2e.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "academy-economy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/run-academy-economy.sh"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "touch-targets"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-touch-targets.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_openai_ai_integrations:2.0.0", "javascript_log_in_with_replit:2.0.0", "javascript_object_storage:2.0.0", "resend:1.0.0", "javascript_anthropic_ai_integrations:2.0.0", "javascript_openrouter_ai_integrations:2.0.0"]

[userenv]

[userenv.shared]
SUPPORT_PORTAL_URL = "https://student-support-portal--mrterryflood.replit.app"
CIVIC_SIGNAL_BASE_URL = "https://power2thepeople.net"
GPP_API_URL = "https://justproposals.net"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
