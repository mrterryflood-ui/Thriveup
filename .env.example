# Source environment-variable INVENTORY only (2026-09-26).
# These are placeholders, not credentials and not a ready-to-deploy Convex/Vercel config.
# Do not populate this file with actual values or commit real .env files.
# On Convex, DATABASE_URL is NOT a substitute for a Convex data model.

# Current PostgreSQL and Express sessions: source-only until replaced.
DATABASE_URL=<source-postgres-url-do-not-commit>
SESSION_SECRET=<source-session-secret-do-not-commit>
DB_CONNECTION_TIMEOUT_MS=<optional-milliseconds>
DB_QUERY_TIMEOUT_MS=<optional-milliseconds>
DB_MIGRATION_LOCK_TIMEOUT_MS=<optional-milliseconds>
DB_MIGRATION_QUERY_TIMEOUT_MS=<optional-milliseconds>

# Replit-issued or Replit-host-specific: replace, do not copy to the target.
REPL_ID=<replit-oidc-client-id-source-only>
ISSUER_URL=<replit-oidc-issuer-source-only>
REPLIT_DOMAINS=<replit-host-source-only>
REPLIT_DEV_DOMAIN=<replit-dev-host-source-only>
REPLIT_DEPLOYMENT=<replit-platform-flag-source-only>
REPLIT_DEPLOYMENT_ID=<replit-platform-id-source-only>
REPLIT_DEPLOYMENT_URL=<replit-host-source-only>
REPL_IDENTITY=<replit-identity-source-only>
WEB_REPL_RENEWAL=<replit-platform-flag-source-only>
REPLIT_CONNECTORS_HOSTNAME=<replit-connector-host-source-only>
PRIVATE_OBJECT_DIR=<replit-private-storage-root-source-only>
PUBLIC_OBJECT_SEARCH_PATHS=<replit-public-storage-roots-source-only>

# AI integrations (Replit proxy settings are source-only).
AI_INTEGRATIONS_ANTHROPIC_API_KEY=<replit-proxy-key-source-only>
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=<replit-proxy-url-source-only>
AI_INTEGRATIONS_OPENAI_API_KEY=<replit-proxy-key-source-only>
AI_INTEGRATIONS_OPENAI_BASE_URL=<replit-proxy-url-source-only>
AI_INTEGRATIONS_OPENROUTER_API_KEY=<replit-proxy-key-source-only>
AI_INTEGRATIONS_OPENROUTER_BASE_URL=<replit-proxy-url-source-only>
# Direct-provider options: provision independently only if those features remain.
ANTHROPIC_API_KEY=<direct-provider-key-if-enabled>
OPENAI_API_KEY=<direct-provider-key-if-enabled>
GEMINI_API_KEY=<direct-provider-key-if-enabled>
AI_PROVIDER_TIMEOUT_MS=<optional-milliseconds>
AI_REQUEST_DEADLINE_MS=<optional-milliseconds>

# External data sources and service credentials (evaluate each before migration).
BIDNET_USERNAME=<external-username-if-enabled>
BIDNET_PASSWORD=<external-password-if-enabled>
BIDNET_SAVED_SEARCH_URL=<external-url-if-enabled>
CAREERONESTOP_API_KEY=<external-key-if-enabled>
CAREERONESTOP_USER_ID=<external-id-if-enabled>
CENSUS_API_KEY=<external-key-if-enabled>
FBI_CRIME_API_KEY=<external-key-if-enabled>
HUD_API_KEY=<external-key-if-enabled>
OPENSTATES_API_KEY=<external-key-if-enabled>
RFPMART_USERNAME=<external-username-if-enabled>
RFPMART_PASSWORD=<external-password-if-enabled>
SAM_GOV_API_KEY=<external-key-if-enabled>
TWILIO_ACCOUNT_SID=<external-id-if-enabled>
TWILIO_AUTH_TOKEN=<external-key-if-enabled>
TWILIO_FROM_NUMBER=<external-number-if-enabled>
USDA_NASS_API_KEY=<external-key-if-enabled>

# Partner integration names: inbound and outbound credentials have different trust scopes.
CHILDCORE_API_KEY=<outbound-key-if-enabled>
CHILDCORE_TRUSTED_API_ORIGINS=<allowlist-if-enabled>
CIVIC_SIGNAL_BASE_URL=<partner-url-if-enabled>
CIVIC_SIGNAL_ECOSYSTEM_KEY=<partner-key-if-enabled>
CIVIC_SIGNAL_PARTNER_KEY_ID=<partner-id-if-enabled>
CIVIC_SIGNAL_PARTNER_ORIGIN=<partner-origin-if-enabled>
CIVIC_SIGNAL_PARTNER_READ_KEY_ID=<partner-id-if-enabled>
CIVIC_SIGNAL_PARTNER_READ_TOKEN=<partner-token-if-enabled>
CIVIC_SIGNAL_PARTNER_TOKEN=<partner-token-if-enabled>
CIVIC_SIGNAL_PULL_URL=<partner-url-if-enabled>
CIVIC_SIGNAL_PUSH_URL=<partner-url-if-enabled>
CODE_CANVAS_ECOSYSTEM_KEY=<partner-key-if-enabled>
COMMUNITY_API_KEY=<partner-key-if-enabled>
CROSS_PLATFORM_API_KEY=<partner-key-if-enabled>
ECOSYSTEM_PARTNER_KEY_1=<partner-key-if-enabled>
ECOSYSTEM_PARTNER_KEY_2=<partner-key-if-enabled>
ECS_PARTNER_KEY=<partner-key-if-enabled>
GPP_ALLOWED_HOSTS=<partner-host-allowlist-if-enabled>
GPP_API_KEY=<partner-key-if-enabled>
GPP_API_URL=<partner-url-if-enabled>
GPP_EMBED_URL=<partner-url-if-enabled>
GPP_MIRROR_OUTBOUND_KEY=<partner-key-if-enabled>
GPP_MIRROR_URL=<partner-url-if-enabled>
GPP_OPPORTUNITY_HANDOFF_API_KEY=<partner-key-if-enabled>
GPP_OPPORTUNITY_HANDOFF_URL=<partner-url-if-enabled>
GRANTPATHPRO_WEBHOOK_API_KEY=<partner-key-if-enabled>
RPLICE_API_KEY=<partner-key-if-enabled>
RPLICE_THRIVEUP_API_URL=<partner-url-if-enabled>
SHADOW_OBSERVER_KEY=<partner-key-if-enabled>
THRIVE_GPP_API=<partner-url-if-enabled>
THRIVE_GPP_API_KEY=<partner-key-if-enabled>
THRIVEUP_API_KEY=<partner-key-if-enabled>
THRIVEUP_CALLBACK_API_KEY=<partner-key-if-enabled>
THRIVEUP_INBOUND_KEY=<partner-key-if-enabled>
THRIVEUP_INGEST_KEY=<partner-key-if-enabled>
THRIVEUP_ISSUED_KEY=<partner-key-if-enabled>
THRIVEUP_PARTNER_KEY=<partner-key-if-enabled>
THRIVEUP_SHARED_SECRET=<partner-secret-if-enabled>

# Public URLs and runtime flags (review use before target provisioning).
APP_BASE_URL=<public-url-if-used>
APP_URL=<public-url-if-used>
BASE_URL=<public-url-if-used>
PRODUCTION_URL=<public-url-if-used>
PROD_URL=<public-url-if-used>
PUBLISHED_BASE_URL=<public-url-if-used>
NODE_ENV=<development-or-production>
PORT=<host-provided-port>
VERCEL=<platform-provided-flag>

# Alerts, probes and operator tooling. Some are test-only; not all belong in Vercel.
AI_ALERT_RECIPIENT=<recipient-if-enabled>
COMMUNITY_BRIEF_PROBE_URL=<probe-url-if-enabled>
EQUITY_LOSS_PROBE_URL=<probe-url-if-enabled>
GRANT_DIGEST_RECIPIENTS=<recipients-if-enabled>
HUB_INTEL_DAILY_TOKEN_CAP=<optional-integer>
E2E_BASE_URL=<test-only-url>
PARTNER_API_CONTRACT_TARGET=<test-only-target>
PROBE_ALERT_TEST_RECIPIENT=<test-only-recipient>
TEST_PARTNER_KEY=<test-only-key>
ZIP=<tooling-only-zip-if-used>

# Convex credentials/config, new auth-provider config, new storage config,
# and direct Resend credentials are intentionally NOT invented here.
# Obtain those from the chosen target services after their integration design.