flowchart LR
    subgraph "Phase A — Always fires"
        H1["POST /heartbeat<br/>Is ThriveUp live?<br/>All personas"]
    end

    subgraph "Phase B — Fires if heartbeat ✅"
        CB["GET /community/brief<br/>impact data, coverage data<br/>Director, Funder, Policy,<br/>Organizer, Researcher"]
        PUSH["POST /push<br/>ChildCORE pushes<br/>county coverage metrics<br/>back to ThriveUp<br/>YHSI Coordinator"]
    end

    subgraph "Phase C — Fires if chainweb:read active"
        CWT["GET /chainweb/templates<br/>ROI calculation models<br/>Funder, Director, Organizer"]
        CWS["POST /chainweb/scenarios<br/>Run ROI scenario for ZIP<br/>Funder, Director, Organizer"]
    end

    subgraph "Phase D — Fires if yhsi:read active"
        YO["GET /yhsi/outcomes-summary<br/>12-26 outcomes for region<br/>Policy, Researcher, School,<br/>YHSI Coordinator"]
        YM["GET /yhsi/metrics<br/>Longitudinal KPIs<br/>Researcher, Funder"]
    end

    subgraph "Phase E — Fires if student:read active"
        SO["GET /students/overview<br/>K-12 pipeline data<br/>School, Policy"]
        EW["GET /early-warnings<br/>At-risk population flags<br/>Policy, YHSI Coordinator"]
    end

    H1 --> CB
    H1 --> PUSH
    CB --> CWT
    CWT --> CWS
    CB --> YO
    YO --> YM
    CB --> SO
    SO --> EW

