<html>
  <head>
  <meta charset="utf-8">
  <style>
  body { font-family: 'Calibri', 'Arial', sans-serif; font-size: 11pt; line-height: 1.5; margin: 1in; color: #1a1a1a; }
  h1 { font-size: 16pt; font-weight: bold; text-align: center; margin-bottom: 4pt; }
  h2 { font-size: 13pt; font-weight: bold; margin-top: 16pt; margin-bottom: 6pt; border-bottom: 1px solid #333; padding-bottom: 3pt; }
  h3 { font-size: 11pt; font-weight: bold; margin-top: 12pt; margin-bottom: 4pt; }
  p { margin: 4pt 0; }
  .header-info { text-align: center; font-size: 10pt; margin-bottom: 2pt; }
  .period { text-align: center; font-size: 11pt; font-weight: bold; margin: 8pt 0 16pt 0; }
  table { border-collapse: collapse; width: 100%; margin: 8pt 0; }
  th { background: #2c3e50; color: white; padding: 6pt 10pt; text-align: left; font-size: 10pt; font-weight: bold; }
  td { border: 1px solid #ccc; padding: 5pt 10pt; font-size: 10pt; }
  tr:nth-child(even) { background: #f9f9f9; }
  .total-row td { font-weight: bold; border-top: 2px solid #333; background: #e8e8e8; }
  .section-row td { font-weight: bold; background: #f0f4f8; border-top: 1px solid #999; }
  .amount { text-align: right; }
  .note { font-size: 9pt; color: #555; font-style: italic; margin-top: 4pt; }
  .footer { margin-top: 24pt; font-size: 9pt; color: #666; border-top: 1px solid #ccc; padding-top: 8pt; }
  .signature { margin-top: 36pt; }
  .sig-line { border-bottom: 1px solid #333; width: 250px; display: inline-block; margin-top: 24pt; }
  </style>
  </head>
